&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;  &lt;span class=&#34;nx&#34;&gt;storage&lt;/span&gt;: &lt;span class=&#34;kt&#34;&gt;multer.diskStorage&lt;/span&gt;&lt;span class=&#34;p&#34;&gt;({&lt;/span&gt;
